#!/bin/sh
# {kgate} демон-супервизор VPN-стека (замена S99sing-box/watchdog/boot-autoup)
DAEMON=/opt/sbin/kgate
CFG=/opt/etc/kgate/kgate.yaml
PIDFILE=/opt/var/run/kgate.pid
case "$1" in
  start)
    if [ -f $PIDFILE ] && [ -d /proc/$(cat $PIDFILE) ]; then echo "kgate already running"; exit 0; fi
    # stray sweep: a stale pidfile can leave an orphan daemon double-supervising
    # the stack (two relays/APIs fighting over the same ports)
    killall kgate 2>/dev/null
    sleep 1
    $DAEMON serve -c $CFG >> /opt/var/log/kgate-boot.log 2>&1 &
    echo $! > $PIDFILE
    echo "kgate daemon started"
    ;;
  stop)
    # Stopping the supervisor must always restore direct connectivity: a stale
    # up Proxy0 with a dead upstream blackholes the whole LAN
    ndmc -c "interface Proxy0 down" >/dev/null 2>&1
    [ -f $PIDFILE ] && kill $(cat $PIDFILE) 2>/dev/null; rm -f $PIDFILE
    killall kgate 2>/dev/null
    echo "kgate stopped" ;;
  status)
    [ -f $PIDFILE ] && [ -d /proc/$(cat $PIDFILE) ] && echo running || echo stopped ;;
  restart)
    $0 stop
    sleep 1
    $0 start ;;
  *) echo "usage: $0 {start|stop|restart|status}" ;;
esac
