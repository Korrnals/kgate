# kgate.yaml — единый конфиг (клиент на ноутбуке + демон на роутере)
# Любое поле можно переопределить переменными окружения KGATE_*:
# KGATE_API_PORT, KGATE_DAEMON_LOG, KGATE_DAEMON_BOOT_AUTOUP и т.д. (см. docs/admin/configuration.md)
# Скопируй в ~/.kgate/kgate.yaml или рядом с бинарником.

host: 192.168.1.1
server_ip: 203.0.113.10  # IP hy2 exit-сервера (для ndm route-pin)
ssh_port: 222            # ssh для деплоя (kgate apply)
ssh_user: root
ssh_key: ~/.ssh/kgate-ed25519    # ключ с доступом к роутеру

api:
  port: 9443             # порт mTLS API демона на роутере
  ca: ~/.kgate/ca.crt    # клиентские сертификаты (генерируются при kgate apply)
  cert: ~/.kgate/client.crt
  key: ~/.kgate/client.key

daemon:                  # секция для `kgate serve` (на роутере)
  singbox_bin: /opt/sbin/sing-box
  singbox_config: /opt/etc/sing-box/config.json
  singbox_log: /opt/var/log/singbox.log
  rlimit_nofile: 8192            # FD-лимит, наследуется sing-box'ом
  supervisor_interval: 15s       # тик супервизора (недожатые дети/dns-правила)
  boot_autoup: true              # поднимать туннель (Proxy0) после старта
  autoup_delay: 25s              # ждать :1080 до подъёма (без гонки с Entware)
  api_listen: ":9443"            # mTLS API (клиентские серты обязательны)
  web_root: /opt/etc/kgate       # ca.crt/server.crt/server.key демона
  log: /opt/var/log/kgate.log

# --- policies: декларативные hotspot-привязки (1.8.0) -----------------------
# kgate apply применяет их идемпотентно после ndm-стадии (только недостающие
# вербы), kgate destroy снимает перед удалением политик.
# Ключ segments = ndm-имя интерфейса РОВНО как в running-config
# (`policy Home VPN`), НЕ description («WLAN»). Разрешены VPN|NO-VPN:
# VPN → объект «VPN» («Туннель - весь трафик идет через VPN»),
# NO-VPN → объект «NO-VPN» («Напрямую - …»).
# policies:
#   segments:
#     Home: VPN
#     Bridge2: NO-VPN
#   devices:
#     - mac: "54:AE:BC:9C:DE:BF"
#       policy: NO-VPN

# --- panel: встроенная веб-панель (HTTPS :8443) -----------------------------
# Панель включена ТОЛЬКО если задан password (пусто/нет секции = выключена).
# Пишется kgate deploy'ом в /opt/etc/kgate/kgate.yaml вместе с остальным.
# Открывается с телефона: https://192.168.1.1:8443/kgate/
# (self-signed сертификат — браузер предупредит, «расширенные → перейти»).
# Вход — этим паролем; сессия 12ч; кнопка «← Приложения» ведёт на return_url.
# panel:
#   password: CHANGE_ME     # ОБЯЗАТЕЛЬНО поменяй — иначе панель не включится
#   port: 8443              # Entware-порты из LAN доступны без firewall-правил (как :9443)
#   return_url: http://192.168.1.1/   # кнопка «← Приложения» (домашняя Keenetic)
